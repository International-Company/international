# ---------------------------------------------------------------------------
# IFMS — Environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# The Prisma provider is derived from this URL automatically by
# scripts/prepare-db.mjs — you never edit schema.prisma to switch engines.
#
#   file:./dev.db                     -> sqlite      (local, zero setup)
#   postgresql://user:pass@host/db    -> postgresql  (Railway / production)
#
# On Railway, add a PostgreSQL service and set this to ${{Postgres.DATABASE_URL}}.
DATABASE_URL="file:./dev.db"

# Security ------------------------------------------------------------------
# 32+ byte random secret used to sign session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-secret-value-at-least-32-chars"

# Session lifetime in minutes (idle timeout) and absolute maximum.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Application ---------------------------------------------------------------
APP_NAME="IFMS"
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Background worker ---------------------------------------------------------
# Enables the in-process job scheduler (sync, backups, maintenance).
JOBS_ENABLED=true
JOBS_TICK_SECONDS=30

# Storage -------------------------------------------------------------------
# NOTE: on a platform with an ephemeral filesystem (Railway, Fly, Heroku) this
# directory is wiped on every deploy. Attach a volume, or rely on the database
# provider's own managed backups.
BACKUP_DIR="./storage/backups"

# Seeding -------------------------------------------------------------------
# Demo rates, customers and opening balances. Defaults to on outside
# production; set "false" to suppress, "true" to force.
# SEED_DEMO_DATA="false"
#
# Password for the initial administrator on a production seed. If unset, one is
# generated and printed ONCE to the deploy log.
# ADMIN_PASSWORD=""

# USDT / blockchain providers ----------------------------------------------
# Leave blank to run the built-in MANUAL provider (no external calls).
# TRON (TRC-20)
TRON_API_BASE="https://api.trongrid.io"
TRON_API_KEY=""
TRON_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# The key that lets the program send USDT on its own. Leave it empty and it
# cannot — the office sends by hand, which is the safe default.
#
# Set it only to a HOT wallet holding a small float, never to the main
# holdings: whoever reaches the server reaches this key, and the key is the
# coins. Set it in Railway's variables, never in a file that is committed.
TRON_HOT_WALLET_KEY=""

# Ethereum (ERC-20)
ETH_API_BASE="https://api.etherscan.io/api"
ETH_API_KEY=""
ETH_USDT_CONTRACT="0xdAC17F958D2ee523a2206206994597C13D831ec7"

# BNB Smart Chain (BEP-20). Empty uses a public node; set a keyed RPC if needed.
BSC_RPC_URL=""
BSC_USDT_CONTRACT="0x55d398326f99059fF775485246999027B3197955"
BSC_LOG_RANGE="3000"
BSC_MAX_REACH="9000"

# Biometric sign-in (WebAuthn) ------------------------------------------------
# The domain a passkey belongs to, and the exact origin it may be used from.
# A key registered against one domain is refused on any other — which is the
# property that makes it phishing-resistant, and also the property that breaks
# sign-in if these are wrong.
#
# Leave both blank in development: they follow the request, so localhost works
# with no configuration. Set them in production to the real host, because behind
# a proxy the request the server sees is not always the one the browser made.
#   WEBAUTHN_RP_ID="exchange.example.com"       (no scheme, no port, no path)
#   WEBAUTHN_ORIGIN="https://exchange.example.com"
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGIN=""
