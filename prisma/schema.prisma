// ---------------------------------------------------------------------------
// IFMS — International Financial Management System
// Persistence model for the modular monolith.
//
// CONVENTIONS
//   * Money is NEVER stored as a float. Every monetary value is a BigInt of
//     minor units scaled by 1e8 (see src/core/money). 1.00 USD => 100000000n.
//     Exchange rates use the same scale.
//   * Enum-like columns are `String` with a documented value set, enforced by
//     Zod at the application boundary. This keeps the schema portable across
//     SQLite (default) and PostgreSQL, neither of which agree on enum support.
//   * JSON payloads are stored as serialized `String` for the same reason.
//   * Ledger and audit rows are append-only. The application layer never
//     issues UPDATE/DELETE against them; corrections are made by reversal.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // To deploy on PostgreSQL: change provider to "postgresql" and point
  // DATABASE_URL at the server. No model changes are required.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ORGANISATION
// ===========================================================================

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Hebron")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  transactions    Transaction[]
  customers       Customer[]
  businessDays    BusinessDay[]
  depositRequests UsdtDepositRequest[]

  @@map("branches")
}

// ===========================================================================
// IDENTITY & ACCESS
// ===========================================================================

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique

  employeeCode String? @unique
  fullNameEn   String
  fullNameAr   String
  phone        String?
  jobTitleEn   String?
  jobTitleAr   String?

  // Credentials — scrypt (N=2^15). Format: scrypt$N$r$p$salt$hash
  passwordHash       String
  passwordUpdatedAt  DateTime @default(now())
  mustChangePassword Boolean  @default(false)

  // Second factor (TOTP). Ready to enable per user.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorConfirmedAt DateTime?
  recoveryCodes        String? // JSON: string[] of scrypt-hashed single-use codes

  // ACTIVE | SUSPENDED | LOCKED | DISABLED
  status           String    @default("ACTIVE")
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Preferences
  locale   String @default("ar") // ar | en
  theme    String @default("system") // light | dark | system
  density  String @default("comfortable") // comfortable | compact
  timezone String @default("Asia/Hebron")

  lastLoginAt DateTime?
  lastLoginIp String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  roles           UserRole[]
  permissions     UserPermission[]
  sessions        Session[]
  passwordHistory PasswordHistory[]
  drafts          Draft[]
  notifications   NotificationRecipient[]

  createdTransactions Transaction[]        @relation("TransactionCreatedBy")
  confirmedTransfers  Transaction[]        @relation("TransactionTransferConfirmedBy")
  openedDays          BusinessDay[]        @relation("DayOpenedBy")
  closedDays          BusinessDay[]        @relation("DayClosedBy")
  backups             Backup[]
  wallets             Wallet[]
  drawerMovements     DrawerMovement[]
  cutoffRates         CutoffRate[]
  rates               ExchangeRate[]
  depositRequests     UsdtDepositRequest[]

  @@index([status])
  @@index([branchId])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // ADMIN, MANAGER, TELLER, AUDITOR, ...
  nameEn      String
  nameAr      String
  description String?
  // Lower number = higher authority. Used for "can this user manage that user".
  level       Int     @default(100)
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // "exchange.transaction.reverse"
  module      String
  action      String
  nameEn      String
  nameAr      String
  description String?
  // Permissions flagged sensitive require an explicit grant and are audited.
  isSensitive Boolean @default(false)

  roles RolePermission[]
  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user override on top of role permissions. DENY always wins.
model UserPermission {
  userId       String
  permissionId String
  effect       String    @default("ALLOW") // ALLOW | DENY
  reason       String?
  expiresAt    DateTime?
  assignedAt   DateTime  @default(now())
  assignedBy   String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique // SHA-256 of the opaque session token

  ip        String?
  userAgent String?

  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime // sliding idle expiry
  absoluteExpiresAt DateTime // hard ceiling, never extended
  revokedAt         DateTime?
  revokedReason     String?

  // Set once the second factor has been satisfied for this session.
  twoFactorAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  username   String
  ip         String?
  userAgent  String?
  successful Boolean
  reason     String?
  at         DateTime @default(now())

  @@index([username, at])
  @@index([ip, at])
  @@map("login_attempts")
}

// ===========================================================================
// CURRENCIES, RATES
// ===========================================================================

model Currency {
  code      String  @id // ILS, USD, JOD, USDT
  nameEn    String
  nameAr    String
  symbol    String
  // Display precision. Storage precision is always 1e8.
  decimals  Int     @default(2)
  kind      String  @default("FIAT") // FIAT | CRYPTO
  isActive  Boolean @default(true)
  isBase    Boolean @default(false)
  sortOrder Int     @default(0)

  baseRates   ExchangeRate[] @relation("RateBase")
  quoteRates  ExchangeRate[] @relation("RateQuote")
  /// One per kind: the till, and the branch's account at a bank.
  drawers     Drawer[]
  cutoffRates CutoffRate[]

  @@map("currencies")
}

/// Rate rows are never mutated. Superseding a rate closes the previous row by
/// stamping `effectiveTo`, which yields a complete, queryable rate history.
model ExchangeRate {
  id        String @id @default(cuid())
  baseCode  String
  quoteCode String

  /// CASH | BROKER — which balance the money is paid out of.
  ///
  /// The counter charges a different price depending on where the money comes
  /// from: notes out of the till are one price, a transfer through the broker
  /// is another. So a pair does not have "a rate" — it has one per channel, and
  /// quoting without saying which is asking an incomplete question.
  channel String @default("CASH")

  buyRate  BigInt // scaled 1e8 — company BUYS base at this rate
  sellRate BigInt // scaled 1e8 — company SELLS base at this rate
  midRate  BigInt

  source        String    @default("MANUAL") // MANUAL | PROVIDER | IMPORT
  providerRef   String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  base  Currency @relation("RateBase", fields: [baseCode], references: [code])
  quote Currency @relation("RateQuote", fields: [quoteCode], references: [code])

  transactions Transaction[]

  @@index([baseCode, quoteCode, channel, isActive])
  @@index([effectiveFrom])
  @@map("exchange_rates")
}

// ===========================================================================
// LEDGER — double entry
// ===========================================================================

/// What the branch physically holds, one row per currency.
///
/// This replaced a chart of accounts and a double-entry ledger. The system does
/// two things — take USDT and hand cash back, or swap one cash currency for
/// another — and both are a movement between two of these rows. A journal
/// proving every movement balanced was answering a question this product no
/// longer asks.
///
/// The balance here is the record, not a cache of one. Every change goes through
/// `drawer.service`, inside a database transaction, so it can never be applied
/// twice or computed from a stale read.
model Drawer {
  id String @id @default(cuid())

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// CASH | BANK — the till, or the branch's account at a bank.
  ///
  /// A bank balance is the same object as a till: money you pay out of and must
  /// not overdraw. Modelling it as a second drawer rather than a new concept
  /// means the movements, the atomic increments and `verifyBalances()` all keep
  /// working with no second engine to keep honest.
  kind String @default("CASH")

  nameEn String
  nameAr String

  /// Scaled 1e8, like every amount in this system.
  balance BigInt @default(0)

  /// A drawer allowed to go short. Off for cash: a negative till is a counting
  /// mistake, not a position.
  allowNegative Boolean @default(false)

  /// Warn the manager below this. Zero disables the warning.
  lowBalanceThreshold BigInt @default(0)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements DrawerMovement[]
  wallets   Wallet[]
  positions DayPosition[]

  @@unique([currencyCode, kind])
  @@index([isActive, sortOrder])
  @@map("drawers")
}

/// Every change to a drawer, append-only.
///
/// Not a journal: there is no opposite line and nothing has to balance. It
/// exists so a balance can be explained — this drawer holds what it holds
/// because of these movements — which is the part of a ledger still worth
/// having at this size.
model DrawerMovement {
  id       String @id @default(cuid())
  drawerId String
  drawer   Drawer @relation(fields: [drawerId], references: [id])

  /// IN | OUT
  direction    String
  amount       BigInt
  /// The drawer balance immediately after this movement was applied.
  balanceAfter BigInt

  /// TRANSACTION | FUNDING | REVERSAL
  reason String

  /// Why a funding movement happened, which the daily result cannot be measured
  /// without. Money the owner puts in is not profit and money they take out is
  /// not a loss, so the two have to be told apart from everything else before
  /// the change in the branch's worth means anything.
  ///
  /// OWNER_IN | OWNER_OUT | EXPENSE | TRANSFER | CORRECTION. Null on anything
  /// that is not funding — a transaction says why it happened by being one.
  category String?

  /// Which of the broker's accounts this went through.
  ///
  /// The office keeps no books per account — its claim is on the broker, not on
  /// an account — but the instruction that leaves for him has to say which one,
  /// and this is the only place that survives long enough to be checked against
  /// his statement afterwards. Null on anything that did not go through him.
  account String?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  /// The day this movement belongs to.
  ///
  /// Not the calendar date it happened on. A day is opened and closed by hand,
  /// and the result of one is measured by what moved inside it — so a manager
  /// funding the till at half past midnight, or a day opened for a date that is
  /// not today, must land where the close will look for it. Every other way
  /// money moves already belongs to a day; this makes funding belong too.
  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([drawerId, createdAt])
  @@index([transactionId])
  @@index([businessDayId])
  @@index([account])
  @@map("drawer_movements")
}

// ===========================================================================
// CUSTOMERS
// ===========================================================================

model Customer {
  id   String @id @default(cuid())
  code String @unique

  type       String  @default("INDIVIDUAL") // INDIVIDUAL | COMPANY
  fullNameEn String
  fullNameAr String
  phone      String?
  altPhone   String?
  email      String?

  nationalId String?
  passportNo String?
  taxNumber  String?

  address String?
  city    String?
  country String  @default("PS")

  // NONE | PENDING | VERIFIED | REJECTED | EXPIRED
  kycStatus     String    @default("NONE")
  kycVerifiedAt DateTime?
  riskLevel     String    @default("LOW") // LOW | MEDIUM | HIGH
  isBlocked     Boolean   @default(false)
  blockReason   String?

  /// Maximum negative balance allowed, scaled 1e8, in `creditCurrency`.
  creditLimit    BigInt  @default(0)
  creditCurrency String?

  notes String?
  tags  String? // JSON: string[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions    Transaction[]
  documents       CustomerDocument[]
  depositRequests UsdtDepositRequest[]

  @@index([fullNameEn])
  @@index([fullNameAr])
  @@index([phone])
  @@index([kycStatus])
  @@map("customers")
}

model CustomerDocument {
  id         String    @id @default(cuid())
  customerId String
  type       String // ID_CARD | PASSPORT | TRADE_LICENSE | OTHER
  number     String
  issuedAt   DateTime?
  expiresAt  DateTime?
  issuer     String?
  fileRef    String?
  notes      String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

// ===========================================================================
// EXCHANGE — transactions
// ===========================================================================

model Transaction {
  id        String @id @default(cuid())
  reference String @unique // TXN-20260808-00001

  /// EXCHANGE — cash for cash on the machine.
  /// USDT_RECEIVE — USDT taken at the window, cash handed back.
  /// USDT_SEND — cash taken at the window, USDT sent to the customer's wallet.
  /// REMITTANCE_OUT / REMITTANCE_IN — a transfer carried by the correspondent.
  /// All the same shape: the customer gives one thing and takes another.
  type   String
  /// POSTED | PENDING_TRANSFER | REVERSED. Recording is posting; there is no
  /// draft and no approval.
  ///
  /// PENDING_TRANSFER means the money has already left the branch's balances —
  /// the bank leg is reserved the instant it is promised — but nobody has yet
  /// confirmed the transfer actually went out. It is a promise awaiting proof,
  /// not money awaiting a decision.
  status String @default("POSTED")

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // --- Amounts (all scaled 1e8) -------------------------------------------
  fromCurrency String
  fromAmount   BigInt
  toCurrency   String
  toAmount     BigInt
  /// Applied rate, scaled 1e8. 1 unit of fromCurrency = rate units of toCurrency.
  rate         BigInt        @default(100000000)
  rateId       String?
  appliedRate  ExchangeRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)

  /// Spread earned against the mid rate, in toCurrency. Shown to the manager.
  profitAmount BigInt @default(0)

  // --- How the customer paid, and how they were paid ----------------------
  //
  // Each pair always sums to exactly its own total — the intake legs to
  // `fromAmount`, the payout legs to `toAmount`. Not approximately: a split
  // that is allowed to disagree with its own total leaks a fraction on every
  // trade, and the server refuses one that does.
  //
  // Both sides can be split because both sides can go through the broker. A
  // customer buying USDT may hand over part in notes and transfer the rest to
  // the broker's account, at a different price for each part — the mirror of
  // the exchange machine, where the branch pays out the same two ways.
  //
  // The ordinary all-cash trade leaves both broker legs at zero, so nothing
  // about its shape changes.
  intakeCashAmount   BigInt @default(0)
  intakeBrokerAmount BigInt @default(0)
  payoutCashAmount   BigInt @default(0)
  payoutBankAmount   BigInt @default(0)

  /// Which of the broker's accounts the customer paid into. Null unless the
  /// intake had a broker leg. Free text for the same reason as the payout
  /// channel below.
  intakeBankChannel String?

  /// Where the transfer was sent — a bank, a wallet service, whatever the
  /// manager has listed. Free text rather than a foreign key on purpose: the
  /// name is a fact about a transfer that already happened, and renaming or
  /// removing a destination later must not rewrite what was recorded at the
  /// time. Null whenever there was no bank leg.
  payoutBankChannel String?

  /// Where the USDT was sent, for a withdrawal. Recorded as typed: the address
  /// is a fact about a transfer that already happened, and it belongs to the
  /// customer rather than to anything this system owns.
  payoutAddress String?

  /// Which of the branch's wallets the withdrawal was promised from. It fixes
  /// the network the address was checked against, and it is where the outgoing
  /// transfer will be looked for when the promise is reconciled.
  payoutWalletId String?
  payoutWallet   Wallet? @relation("TransactionPayoutWallet", fields: [payoutWalletId], references: [id], onDelete: SetNull)

  /// When someone confirmed the promised transfer actually left. Null while
  /// pending. It covers both promises a branch can make — a bank transfer
  /// through the broker, and USDT sent from the branch's own wallet.
  transferConfirmedAt   DateTime?
  transferConfirmedById String?
  transferConfirmedBy   User?     @relation("TransactionTransferConfirmedBy", fields: [transferConfirmedById], references: [id], onDelete: SetNull)

  // --- Who was at the window ----------------------------------------------
  counterpartyName  String?
  counterpartyPhone String?

  notes String?

  createdById String
  createdBy   User   @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  reversalOfId  String?      @unique
  reversalOf    Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    Transaction? @relation("TransactionReversal")
  reverseReason String?

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts         Receipt[]
  movements        DrawerMovement[]
  chainTransaction ChainTransaction?
  depositRequest   UsdtDepositRequest?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdById, createdAt])
  @@index([customerId])
  @@map("transactions")
}

model Receipt {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  number          String    @unique
  locale          String    @default("ar")
  printedCount    Int       @default(0)
  lastPrintedAt   DateTime?
  lastPrintedById String?
  createdAt       DateTime  @default(now())

  @@index([transactionId])
  @@map("receipts")
}

// ===========================================================================
// DAILY CLOSING
// ===========================================================================

/// The rate the manager approves for valuing a currency at the close.
///
/// Not a trading rate. The board says what the counter charges; this says what
/// the branch's holdings are worth, and the two are different judgements — the
/// second is the one the owner's profit is measured against.
///
/// One row per currency per day, written only when the manager sets one. A day
/// with no row for a currency uses the most recent earlier row, which is what
/// "the rates roll forward" means: silence is agreement with yesterday, not an
/// absence, and a day whose rates were never touched still values correctly.
model CutoffRate {
  id           String   @id @default(cuid())
  /// Calendar date at 00:00 local time, the same key a business day uses.
  date         DateTime
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// Units of the base currency for one unit of this one, scaled 1e8.
  rate BigInt

  note      String?
  setById   String
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, currencyCode])
  @@index([currencyCode, date])
  @@map("cutoff_rates")
}

/// What a drawer held when a day was closed, and what it was worth.
///
/// Written once, at the close, and never recomputed. The rate is copied onto
/// the row rather than looked up later for the reason every historical figure
/// in this system is frozen: a result that quietly changes when the manager
/// approves tomorrow's rate is not a result, it is a moving opinion about one.
model DayPosition {
  id            String      @id @default(cuid())
  businessDayId String
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id], onDelete: Cascade)

  drawerId String
  drawer   Drawer @relation(fields: [drawerId], references: [id])

  currencyCode String
  /// CASH | BROKER | CORRESPONDENT, copied so a closed day reads on its own.
  kind         String
  balance      BigInt
  /// The cut-off rate applied, scaled 1e8. The base currency's is exactly 1.
  cutoffRate   BigInt

  createdAt DateTime @default(now())

  @@unique([businessDayId, drawerId])
  @@index([businessDayId])
  @@map("day_positions")
}

model BusinessDay {
  id       String   @id @default(cuid())
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
  /// Calendar date at 00:00 local time.
  date     DateTime

  /// OPEN | CLOSING | CLOSED | REOPENED
  status String @default("OPEN")

  openedById String
  openedBy   User     @relation("DayOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime @default(now())

  closedById String?
  closedBy   User?     @relation("DayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime?

  notes String?

  transactions Transaction[]
  positions    DayPosition[]
  movements    DrawerMovement[]

  @@unique([branchId, date])
  @@index([status])
  @@map("business_days")
}

// ===========================================================================
// USDT / BLOCKCHAIN MONITORING
// ===========================================================================

model Wallet {
  id      String @id @default(cuid())
  label   String
  labelAr String

  /// TRON | ETHEREUM | BSC
  network         String
  address         String
  contractAddress String?
  tokenSymbol     String  @default("USDT")

  /// Watch-only wallets are monitored but never debited by the system.
  isWatchOnly Boolean @default(true)
  isActive    Boolean @default(true)

  /// Shown to customers at the counter. A monitored wallet is not automatically
  /// an address we hand out — the manager decides which ones the teller may
  /// display, and the counter screen offers nothing else.
  isCounterAddress Boolean @default(false)
  counterSortOrder Int     @default(0)

  /// The drawer this wallet's holdings count towards.
  drawerId String?
  drawer   Drawer? @relation(fields: [drawerId], references: [id], onDelete: SetNull)

  balance          BigInt    @default(0)
  balanceUpdatedAt DateTime?

  minConfirmations      Int     @default(19)
  notifyOnIncoming      Boolean @default(true)
  notifyOnOutgoing      Boolean @default(true)
  autoCreateTransaction Boolean @default(true)

  syncCursor     String?
  lastSyncedAt   DateTime?
  lastSyncStatus String? // OK | ERROR | NEVER
  lastSyncError  String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions    ChainTransaction[]
  snapshots       WalletSnapshot[]
  syncRuns        WalletSyncRun[]
  depositRequests UsdtDepositRequest[]
  /// Withdrawals the branch promised to send from this wallet.
  payouts         Transaction[]        @relation("TransactionPayoutWallet")

  @@unique([network, address, tokenSymbol])
  @@index([isActive])
  @@index([isCounterAddress, counterSortOrder])
  @@map("wallets")
}

/// A customer standing at the counter, about to send USDT to one of our
/// addresses.
///
/// The record exists before the money does, which is the point: it fixes the
/// exact amount expected and the window it is expected in, so an arriving
/// transfer can be matched to a person rather than guessed at. Without it the
/// only evidence is a chain entry proving that *someone* sent USDT, and paying
/// cash against that is paying against a guess.
model UsdtDepositRequest {
  id        String @id @default(cuid())
  reference String @unique

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
  network  String
  address  String

  /// What the customer said they would send.
  requestedAmount BigInt
  /// What they are asked to send — the requested amount nudged to a value no
  /// other open request shares, so two customers sending "500" are never
  /// confused for one another.
  expectedAmount  BigInt

  /// The currency and rate agreed at the counter, so the payout is the figure
  /// the customer was quoted rather than whatever the rate has moved to by the
  /// time the chain confirms.
  payoutCurrency String
  quotedRate     BigInt
  quotedAmount   BigInt

  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  counterpartyName  String?
  counterpartyPhone String?

  /// OPEN | MATCHED | COMPLETED | EXPIRED | CANCELLED
  status String @default("OPEN")

  matchedChainTransactionId String?           @unique
  matchedChainTransaction   ChainTransaction? @relation(fields: [matchedChainTransactionId], references: [id], onDelete: SetNull)
  matchedAt                 DateTime?

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  cancelReason String?
  notes        String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  expiresAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([walletId, status])
  @@index([expectedAmount, status])
  @@map("usdt_deposit_requests")
}

model WalletSnapshot {
  id       String   @id @default(cuid())
  walletId String
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  balance  BigInt
  at       DateTime @default(now())

  @@index([walletId, at])
  @@map("wallet_snapshots")
}

model WalletSyncRun {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  provider   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | ERROR
  status     String    @default("RUNNING")
  fetched    Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  error      String?

  @@index([walletId, startedAt])
  @@map("wallet_sync_runs")
}

model ChainTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  txHash    String
  network   String
  direction String // IN | OUT

  fromAddress     String
  toAddress       String
  amount          BigInt // scaled 1e8
  tokenSymbol     String  @default("USDT")
  contractAddress String?

  blockNumber    BigInt?
  blockTimestamp DateTime?
  confirmations  Int       @default(0)
  networkFee     BigInt    @default(0)

  /// PENDING | CONFIRMED | FAILED | ORPHANED
  status String @default("PENDING")

  /// Internal transaction created from this on-chain movement.
  linkedTransactionId String?      @unique
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  depositRequest UsdtDepositRequest?

  isReconciled Boolean   @default(false)
  processedAt  DateTime?
  notes        String?

  firstSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([walletId, txHash, direction])
  @@index([status, blockTimestamp])
  @@index([walletId, blockTimestamp])
  @@index([txHash])
  @@map("chain_transactions")
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id String @id @default(cuid())

  /// CRITICAL | WARNING | INFO | SUCCESS
  severity String @default("INFO")
  /// Machine key used for i18n, e.g. "usdt.incoming".
  eventKey String
  module   String

  titleEn String
  titleAr String
  bodyEn  String
  bodyAr  String

  entityType String?
  entityId   String?
  link       String?
  payload    String? // JSON

  isBroadcast Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([severity])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

// ===========================================================================
// AUDIT — append only, hash chained
// ===========================================================================

/// Immutable audit trail. Each row carries the hash of the previous row, so any
/// mutation or deletion breaks the chain and is detected by the verifier
/// (src/modules/audit/verify). The application never updates or deletes rows.
model AuditLog {
  /// Monotonic sequence AND primary key — the chain is ordered by this value.
  id Int @id @default(autoincrement())

  at DateTime @default(now())

  actorId   String?
  actorName String?
  actorIp   String?
  userAgent String?
  sessionId String?

  /// CREATE | UPDATE | DELETE | LOGIN | LOGOUT | POST | REVERSE | CANCEL
  /// | REVERSE | PERMISSION_CHANGE | RATE_CHANGE | WALLET_CHANGE | BACKUP
  /// | RESTORE | SETTING_CHANGE | EXPORT | PRINT | SYNC | SECURITY
  action     String
  module     String
  entityType String?
  entityId   String?

  summaryEn String
  summaryAr String

  beforeData String? // JSON snapshot
  afterData  String? // JSON snapshot
  metadata   String? // JSON

  /// SHA-256 chain: hash = H(prevHash || canonical(record))
  prevHash String
  hash     String @unique

  @@index([at])
  @@index([actorId, at])
  @@index([module, at])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================================================
// SETTINGS
// ===========================================================================

model SystemSetting {
  key         String  @id
  value       String // JSON encoded
  valueType   String  @default("string") // string | number | boolean | json
  category    String  @default("general")
  isSecret    Boolean @default(false)
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

model ApiCredential {
  id               String  @id @default(cuid())
  name             String
  provider         String // TRON | ETHERSCAN | SMTP | WEBHOOK
  /// AES-256-GCM ciphertext, keyed from AUTH_SECRET.
  secretCiphertext String?
  baseUrl          String?
  config           String? // JSON, non-secret
  isActive         Boolean @default(true)

  lastUsedAt  DateTime?
  lastStatus  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, name])
  @@map("api_credentials")
}

// ===========================================================================
// BACKUP
// ===========================================================================

model Backup {
  id        String  @id @default(cuid())
  filename  String
  path      String
  sizeBytes BigInt  @default(0)
  checksum  String? // SHA-256 of the archive

  /// AUTOMATIC | MANUAL
  type   String @default("MANUAL")
  /// PENDING | RUNNING | COMPLETED | FAILED | VERIFIED | CORRUPT
  status String @default("PENDING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  verifiedAt DateTime?
  error      String?
  notes      String?

  appVersion String?
  tableCount Int     @default(0)
  rowCount   Int     @default(0)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  restores RestoreRun[]

  @@index([status, startedAt])
  @@map("backups")
}

model RestoreRun {
  id       String @id @default(cuid())
  backupId String
  backup   Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  /// RUNNING | COMPLETED | FAILED
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  error         String?
  rowsRestored  Int       @default(0)
  requestedById String?

  @@index([backupId])
  @@map("restore_runs")
}

// ===========================================================================
// BACKGROUND WORK
// ===========================================================================

model Job {
  id      String  @id @default(cuid())
  name    String
  queue   String  @default("default")
  payload String? // JSON

  /// PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  status   String @default("PENDING")
  priority Int    @default(100)

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?
  result     String?

  /// Prevents duplicate enqueues of the same logical work.
  uniqueKey String?

  createdAt DateTime @default(now())

  @@index([status, runAt])
  @@index([queue, status])
  @@index([uniqueKey])
  @@map("jobs")
}

model ScheduledTask {
  id              String  @id @default(cuid())
  key             String  @unique
  nameEn          String
  nameAr          String
  jobName         String
  payload         String?
  intervalSeconds Int
  isEnabled       Boolean @default(true)

  lastRunAt  DateTime?
  nextRunAt  DateTime  @default(now())
  lastStatus String? // OK | ERROR
  lastError  String?
  runCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled, nextRunAt])
  @@map("scheduled_tasks")
}

/// Monotonic counters for human-readable document references.
model Sequence {
  key       String   @id // "TXN:20260806"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("sequences")
}

/// Autosaved form state so a teller never loses work in progress.
model Draft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  formKey  String
  entityId String @default("new")
  payload  String // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, formKey, entityId])
  @@index([userId, updatedAt])
  @@map("drafts")
}
