// ---------------------------------------------------------------------------
// IFMS — International Financial Management System
// Persistence model for the modular monolith.
//
// CONVENTIONS
//   * Money is NEVER stored as a float. Every monetary value is a BigInt of
//     minor units scaled by 1e8 (see src/core/money). 1.00 USD => 100000000n.
//     Exchange rates use the same scale.
//   * Enum-like columns are `String` with a documented value set, enforced by
//     Zod at the application boundary. This keeps the schema portable across
//     SQLite (default) and PostgreSQL, neither of which agree on enum support.
//   * JSON payloads are stored as serialized `String` for the same reason.
//   * Ledger and audit rows are append-only. The application layer never
//     issues UPDATE/DELETE against them; corrections are made by reversal.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // To deploy on PostgreSQL: change provider to "postgresql" and point
  // DATABASE_URL at the server. No model changes are required.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ORGANISATION
// ===========================================================================

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Hebron")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  transactions    Transaction[]
  customers       Customer[]
  businessDays    BusinessDay[]
  handovers       Handover[]
  shifts          Shift[]
  depositRequests UsdtDepositRequest[]

  @@map("branches")
  priceExceptions PriceException[]
  shiftReports ShiftReport[]
  tillCounts   TillCount[]
}

// ===========================================================================
// IDENTITY & ACCESS
// ===========================================================================

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique

  employeeCode String? @unique
  fullNameEn   String
  fullNameAr   String
  phone        String?
  jobTitleEn   String?
  jobTitleAr   String?

  // Credentials — scrypt (N=2^15). Format: scrypt$N$r$p$salt$hash
  passwordHash       String
  passwordUpdatedAt  DateTime @default(now())
  mustChangePassword Boolean  @default(false)

  // Second factor (TOTP). Ready to enable per user.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorConfirmedAt DateTime?
  recoveryCodes        String? // JSON: string[] of scrypt-hashed single-use codes

  // ACTIVE | SUSPENDED | LOCKED | DISABLED
  status           String    @default("ACTIVE")
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Preferences
  locale   String @default("ar") // ar | en
  theme    String @default("system") // light | dark | system
  density  String @default("comfortable") // comfortable | compact
  timezone String @default("Asia/Hebron")

  lastLoginAt DateTime?
  lastLoginIp String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  roles           UserRole[]
  permissions     UserPermission[]
  sessions        Session[]
  passkeys        Passkey[]
  heldDrawers     Drawer[]                @relation("DrawerHeldBy")
  drawerGrants    DrawerGrant[]           @relation("DrawerGrantHolder")
  drawerGrantsMade DrawerGrant[]          @relation("DrawerGrantGrantedBy")
  transfersMade      Transfer[]           @relation("TransferCreatedBy")
  transfersApproved  Transfer[]           @relation("TransferApprovedBy")
  transfersConfirmed Transfer[]           @relation("TransferConfirmedBy")
  transfersReversed  Transfer[]           @relation("TransferReversedBy")
  handovers       Handover[]              @relation("HandoverTeller")
  shifts          Shift[]                 @relation("ShiftTeller")
  discrepancies   Discrepancy[]           @relation("DiscrepancyTeller")
  resolvedDiffs   Discrepancy[]           @relation("DiscrepancyResolvedBy")
  tillCounts      TillCount[]             @relation("TillCountTeller")
  tillCountsTaken TillCount[]             @relation("TillCountCountedBy")
  tillAdjustments TillAdjustment[]        @relation("TillAdjustmentTeller")
  tillAdjusted    TillAdjustment[]        @relation("TillAdjustmentBy")
  openingBoxes    TellerOpening[]
  handoversMade   Handover[]              @relation("HandoverCreatedBy")
  handoversTaken  Handover[]              @relation("HandoverConfirmedBy")
  passwordHistory PasswordHistory[]
  drafts          Draft[]
  notifications   NotificationRecipient[]

  createdTransactions Transaction[]        @relation("TransactionCreatedBy")
  confirmedTransfers  Transaction[]        @relation("TransactionTransferConfirmedBy")
  approvedWithdrawals Transaction[]        @relation("TransactionApprovedBy")
  openedDays          BusinessDay[]        @relation("DayOpenedBy")
  closedDays          BusinessDay[]        @relation("DayClosedBy")
  backups             Backup[]
  wallets             Wallet[]
  drawerMovements     DrawerMovement[]
  cutoffRates         CutoffRate[]
  rates               ExchangeRate[]
  depositRequests     UsdtDepositRequest[]

  @@index([status])
  @@index([branchId])
  @@map("users")
  /// The most this person may take in a single deal, on what the customer hands
  /// over, scaled 1e8. Null leaves them on the office's own ceiling.
  ///
  /// A separate idea from a permission, and it has to be: a permission answers
  /// whether they may work the counter at all, and this answers how far they
  /// are trusted at it. Expressing "up to five thousand" as a permission would
  /// mean a permission per amount.
  ///
  /// Compared against whichever currency the deal is in, exactly as the office
  /// ceilings already are — the stricter of the two applies.
  counterLimit BigInt?

  priceExceptionsAsked    PriceException[] @relation("PriceExceptionRequester")
  priceExceptionsDecided  PriceException[] @relation("PriceExceptionApprover")
  staffNotesAbout   StaffNote[] @relation("StaffNoteSubject")
  staffNotesWritten StaffNote[] @relation("StaffNoteAuthor")
  shiftReports ShiftReport[] @relation("ShiftReportTeller")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // ADMIN, MANAGER, TELLER, AUDITOR, ...
  nameEn      String
  nameAr      String
  description String?
  // Lower number = higher authority. Used for "can this user manage that user".
  level       Int     @default(100)
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // "exchange.transaction.reverse"
  module      String
  action      String
  nameEn      String
  nameAr      String
  description String?
  // Permissions flagged sensitive require an explicit grant and are audited.
  isSensitive Boolean @default(false)

  roles RolePermission[]
  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user override on top of role permissions. DENY always wins.
model UserPermission {
  userId       String
  permissionId String
  effect       String    @default("ALLOW") // ALLOW | DENY
  reason       String?
  expiresAt    DateTime?
  assignedAt   DateTime  @default(now())
  assignedBy   String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

/// A device the user can sign in from with their fingerprint or face.
///
/// A WebAuthn credential. The private key never leaves the phone's secure
/// element and is released only after the device verifies the person holding
/// it — so this is two factors in one gesture: something they have, and
/// something they are. The server keeps only the public half, which is useless
/// to whoever steals this table.
///
/// It is also phishing-resistant in a way a password can never be: the browser
/// binds the signature to this origin, so a copy of the login page on another
/// domain gets nothing the real one would accept.
model Passkey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The authenticator's own identifier for this key, base64url.
  credentialId String @unique
  /// The public half, base64url COSE.
  publicKey    String

  /// The authenticator's signature counter, when it keeps one.
  ///
  /// A signature arriving with a counter no higher than the last is evidence
  /// the credential has been cloned, and the sign-in is refused. Many modern
  /// authenticators keep it at zero and the check is skipped — it defends
  /// against the authenticators that do count, which is all it ever could.
  counter BigInt @default(0)

  /// JSON array: usb | nfc | ble | internal | hybrid.
  transports String?
  /// singleDevice | multiDevice — whether the key syncs across the user's devices.
  deviceType String?
  backedUp   Boolean @default(false)

  /// What the user calls this device, so they can tell two of them apart.
  label      String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  createdIp  String?

  @@index([userId])
  @@map("passkeys")
}

/// A one-shot challenge, held only for the seconds between offering it and
/// verifying the answer.
///
/// It exists so a signature cannot be replayed: the row is deleted the moment
/// it is used, and the delete is what decides the race when the same answer
/// arrives twice.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  /// REGISTER | LOGIN
  purpose   String
  /// Set when the user is already known — registering, never signing in.
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

/// Money moving between the treasury and a teller, counted by both.
///
/// The office's money lives at two levels, and this is the only door between
/// them. It is a document rather than a transfer because a transfer is one
/// party's assertion, and what makes a handover trustworthy is that the other
/// party counted it and said so under their own name.
///
/// The sender declares what they are handing over; the receiver counts it and
/// confirms. Nothing moves until they agree — a count that disagrees leaves the
/// document in dispute with both balances untouched, which is the only state
/// from which the truth can still be established.
/// A teller's stretch of work, from the float they took to the one they gave back.
///
/// Opened by confirming a handover into the teller, closed by confirming one
/// out of them. Any number in a day: two tellers passing the counter between
/// them, or one person working a morning and an evening.
///
/// Its whole purpose is that the cash drawer ends at zero. That makes the count
/// absolute — what should be there is the float plus what the teller traded,
/// what is there is what was counted, and the gap belongs to nobody yet.
model Shift {
  id        String @id @default(cuid())
  reference String @unique // SHF-20260811-00001

  tellerId String
  teller   User   @relation("ShiftTeller", fields: [tellerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  /// OPEN | CLOSED
  status String @default("OPEN")

  openingHandoverId String   @unique
  openingHandover   Handover @relation("ShiftOpening", fields: [openingHandoverId], references: [id])

  closingHandoverId String?   @unique
  closingHandover   Handover? @relation("ShiftClosing", fields: [closingHandoverId], references: [id], onDelete: SetNull)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  discrepancies Discrepancy[]
  notes         StaffNote[]
  report        ShiftReport?

  @@index([tellerId, status])
  @@index([businessDayId])
  @@map("shifts")
}

/// A gap between what the books said a teller held and what was counted.
///
/// Suspended, deliberately. At the moment it is found it belongs to nobody: the
/// cameras and the day's operations have not been reviewed, and guessing is
/// worse than waiting. So it sits in the differences balance, where it changes
/// what the office is worth by nothing — the cash is gone and this stands in
/// its place — until somebody decides whose it was.
///
/// The loss, if it is a loss, lands on the day of that decision rather than the
/// day of the discovery. Which is why the ledger reports how old the oldest
/// open one is: a suspense account nobody looks at is where losses go quiet.
model Discrepancy {
  id String @id @default(cuid())

  /// Where the gap was found: a shift's closing count, or a till count. Exactly
  /// one of the two is set.
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  tillCountId String?
  tillCount   TillCount? @relation(fields: [tillCountId], references: [id], onDelete: Cascade)

  tellerId String
  teller   User   @relation("DiscrepancyTeller", fields: [tellerId], references: [id])

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// Expected minus counted. Positive is a shortage; negative is a surplus.
  amount BigInt

  /// OPEN | RESOLVED
  status String @default("OPEN")

  /// MISCOUNT — the money turned up and the count was wrong.
  /// CHARGED_TO_TELLER — it becomes a debt owed by them.
  /// COMPANY_LOSS — the office absorbs it, and the result takes it that day.
  resolution     String?
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?     @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([tellerId])
  @@map("discrepancies")
  notes StaffNote[]
}

/// The teller's own day, written by the system rather than by the teller.
///
/// A manager who has to ask for a report gets the report the teller chose to
/// write. This one is composed at the moment the shift closes, out of the same
/// rows that moved the money — the float he took, what he traded, what the two
/// of them counted, the prices he asked to break — so there is nothing in it he
/// could have shaded and nothing he had to remember.
///
/// **Frozen, like every other historical figure here.** A reversal next week is
/// a real event and belongs to next week; it does not reach back and edit what
/// this shift looked like when it was closed and signed off.
///
/// The observations are the part that makes it worth reading. A page of
/// correct numbers is not a report — somebody still has to notice that the
/// margin is down a third, or that this is the third shortage in five shifts.
/// So the noticing is done here, against **this teller's own history**, and
/// stored as codes with their numbers rather than as sentences: the manager
/// reads them in his own language, and nothing is invented in prose about
/// somebody's money.
model ShiftReport {
  id String @id @default(cuid())

  shiftId String @unique
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  tellerId String
  teller   User   @relation("ShiftReportTeller", fields: [tellerId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  openedAt DateTime
  closedAt DateTime
  /// How long he was on the counter, in whole minutes.
  minutes  Int

  /// The currency every figure below is expressed in, copied so a change of
  /// base currency later cannot silently restate an old report.
  baseCurrency String

  /// What he was handed at the start and what came back, valued in the base.
  floatWorth    BigInt
  returnedWorth BigInt

  deals Int
  /// Counts per transaction type, as JSON — a shape that grows when a new kind
  /// of business is added without a migration for every one.
  dealsByType String

  /// The three numbers, and their sum. Signed as the office reads them: money
  /// he gave the office is positive, money it lost through him is negative.
  margin      BigInt
  differences BigInt
  concessions BigInt
  net         BigInt

  shortages Int
  surpluses Int

  exceptionsAsked   Int
  exceptionsGranted Int

  /// What was noticed, as JSON: `[{ code, tone, params }]`.
  observations String

  createdAt DateTime @default(now())

  @@index([tellerId, closedAt])
  @@index([branchId, closedAt])
  @@map("shift_reports")
}

/// A word from the management to one member of staff, in writing.
///
/// The office already tells a teller things across the counter. What that
/// cannot do is survive: a shortage explained in March and repeated in June is
/// two conversations nobody can point at, and a teller who improved has no way
/// to show it. So a note is a record with a name on it, and it can be attached
/// to the thing it is about — a shift, or a difference — because "you were
/// short on the fourteenth" and "you are often short" are different notes.
///
/// It is read by the person it is about. That is the point of writing it down,
/// and it is also the discipline: a manager who knows the teller will read it
/// writes something the teller can act on.
model StaffNote {
  id String @id @default(cuid())

  /// Who it is about.
  tellerId String
  teller   User   @relation("StaffNoteSubject", fields: [tellerId], references: [id], onDelete: Cascade)

  /// What it is about, when it is about one thing in particular.
  shiftId       String?
  shift         Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  discrepancyId String?
  discrepancy   Discrepancy? @relation(fields: [discrepancyId], references: [id], onDelete: SetNull)

  /// PRAISE | NOTE | WARNING — how it is meant to be read. A system that only
  /// records what went wrong becomes a file nobody wants opened.
  tone String @default("NOTE")

  body String

  createdById String
  createdBy   User     @relation("StaffNoteAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// When the teller opened it. Not an agreement — only proof it was delivered,
  /// so "nobody told me" has an answer either way.
  readAt DateTime?

  @@index([tellerId, createdAt])
  @@map("staff_notes")
}

model Handover {
  id        String @id @default(cuid())
  reference String @unique // HND-20260811-00001

  /// TO_TELLER — the treasury hands a teller their float.
  /// TO_TREASURY — the teller hands back what they hold.
  direction String

  /// PENDING | CONFIRMED | DISPUTED | CANCELLED
  ///
  /// Money moves on exactly one transition: PENDING → CONFIRMED. A dispute
  /// moves nothing, which is what lets it be cancelled and reissued rather than
  /// unwound.
  status String @default("PENDING")

  /// The teller side of it. The other side is always the treasury.
  tellerId String
  teller   User   @relation("HandoverTeller", fields: [tellerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  /// Whoever declared it — the treasury for a float, the teller for a return.
  createdById String
  createdBy   User     @relation("HandoverCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// Whoever counted it. Never the same person as `createdById`; the service
  /// refuses that, because one person signing both halves is the whole thing
  /// this document exists to prevent.
  confirmedById String?
  confirmedBy   User?     @relation("HandoverConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?

  cancelReason String?
  note         String?

  lines       HandoverLine[]
  openedShift Shift?         @relation("ShiftOpening")
  closedShift Shift?         @relation("ShiftClosing")

  @@index([tellerId, status])
  @@index([status, createdAt])
  @@map("handovers")
}

/// One currency of one handover.
model HandoverLine {
  id         String   @id @default(cuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  currencyCode String
  /// CASH | BROKER | CORRESPONDENT
  kind         String

  /// COUNTED — notes that change hands and are counted, so a difference can
  /// arise. ALLOCATED — a balance that never physically moves, such as USDT or
  /// the broker: the receiver acknowledges it and there is nothing to miscount.
  nature String @default("COUNTED")

  /// What the sender says they are handing over.
  amount BigInt

  /// What the receiver counted. Null until confirmed, and on an allocated line
  /// always equal to `amount` — there was nothing to count.
  countedAmount BigInt?

  @@unique([handoverId, currencyCode, kind])
  @@map("handover_lines")
}

model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique // SHA-256 of the opaque session token

  ip        String?
  userAgent String?

  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime // sliding idle expiry
  absoluteExpiresAt DateTime // hard ceiling, never extended
  revokedAt         DateTime?
  revokedReason     String?

  // Set once the second factor has been satisfied for this session.
  twoFactorAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  username   String
  ip         String?
  userAgent  String?
  successful Boolean
  reason     String?
  at         DateTime @default(now())

  @@index([username, at])
  @@index([ip, at])
  @@map("login_attempts")
}

// ===========================================================================
// CURRENCIES, RATES
// ===========================================================================

model Currency {
  code      String  @id // ILS, USD, JOD, USDT
  nameEn    String
  nameAr    String
  symbol    String
  // Display precision. Storage precision is always 1e8.
  decimals  Int     @default(2)
  kind      String  @default("FIAT") // FIAT | CRYPTO
  isActive  Boolean @default(true)
  isBase    Boolean @default(false)
  sortOrder Int     @default(0)

  baseRates     ExchangeRate[] @relation("RateBase")
  quoteRates    ExchangeRate[] @relation("RateQuote")
  /// One per kind: the till, and the branch's account at a bank.
  drawers       Drawer[]
  cutoffRates   CutoffRate[]
  discrepancies Discrepancy[]
  tillCountLines  TillCountLine[]
  tillAdjustments TillAdjustment[]
  openingBoxes    TellerOpening[]

  @@map("currencies")
}

/// Rate rows are never mutated. Superseding a rate closes the previous row by
/// stamping `effectiveTo`, which yields a complete, queryable rate history.
model ExchangeRate {
  id        String @id @default(cuid())
  baseCode  String
  quoteCode String

  /// CASH | BROKER — which balance the money is paid out of.
  ///
  /// The counter charges a different price depending on where the money comes
  /// from: notes out of the till are one price, a transfer through the broker
  /// is another. So a pair does not have "a rate" — it has one per channel, and
  /// quoting without saying which is asking an incomplete question.
  channel String @default("CASH")

  buyRate  BigInt // scaled 1e8 — company BUYS base at this rate
  sellRate BigInt // scaled 1e8 — company SELLS base at this rate
  midRate  BigInt

  source        String    @default("MANUAL") // MANUAL | PROVIDER | IMPORT
  providerRef   String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  base  Currency @relation("RateBase", fields: [baseCode], references: [code])
  quote Currency @relation("RateQuote", fields: [quoteCode], references: [code])

  transactions Transaction[]

  @@index([baseCode, quoteCode, channel, isActive])
  @@index([effectiveFrom])
  @@map("exchange_rates")
}

// ===========================================================================
// LEDGER — double entry
// ===========================================================================

/// What the branch physically holds, one row per currency.
///
/// This replaced a chart of accounts and a double-entry ledger. The system does
/// two things — take USDT and hand cash back, or swap one cash currency for
/// another — and both are a movement between two of these rows. A journal
/// proving every movement balanced was answering a question this product no
/// longer asks.
///
/// The balance here is the record, not a cache of one. Every change goes through
/// `drawer.service`, inside a database transaction, so it can never be applied
/// twice or computed from a stale read.
model Drawer {
  id String @id @default(cuid())

  /// Who holds this drawer: the treasury, or one named teller.
  ///
  /// `TREASURY` or `teller:<userId>`, and a single string rather than a pair of
  /// columns because it is half of a unique key. A nullable owner id cannot
  /// carry one: PostgreSQL treats NULLs as distinct, so two treasury tills of
  /// the same currency would both be allowed and nothing would notice until the
  /// money was in the wrong one.
  ownerKey String @default("TREASURY")

  /// The person, when it is a teller's. Null for the treasury, and kept beside
  /// `ownerKey` only so a drawer can be joined to its holder — the key above is
  /// what identifies it.
  tellerId String?
  teller   User?   @relation("DrawerHeldBy", fields: [tellerId], references: [id], onDelete: Restrict)

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// CASH | BROKER | CORRESPONDENT — the till, the claim on the broker who
  /// moves everything through his own bank accounts, or the running account
  /// with the remittance company.
  ///
  /// All three are the same object as a till: money you pay out of and must not
  /// overdraw. Modelling them as further drawers rather than new concepts means
  /// the movements, the atomic increments and `verifyBalances()` all keep
  /// working with no second engine to keep honest.
  ///
  /// The correspondent is the one that may go short: sending a remittance owes
  /// them money before any of it settles.
  kind String @default("CASH")

  nameEn String
  nameAr String

  /// Scaled 1e8, like every amount in this system.
  balance BigInt @default(0)

  /// A drawer allowed to go short. Off for cash: a negative till is a counting
  /// mistake, not a position.
  allowNegative Boolean @default(false)

  /// Warn the manager below this. Zero disables the warning.
  lowBalanceThreshold BigInt @default(0)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements DrawerMovement[]
  wallets   Wallet[]
  positions DayPosition[]
  grants    DrawerGrant[]
  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")

  @@unique([ownerKey, currencyCode, kind])
  @@index([isActive, sortOrder])
  @@index([tellerId])
  @@map("drawers")
}

/// Money moved from one of the branch's balances to another.
///
/// ## Why this is a record and not two funding movements
///
/// Because it already was two funding movements, and that is the bug. The
/// broker settles in cash, so somebody takes it off his balance and puts it in
/// the till — two separate acts, and the second one can simply not happen. When
/// it does not, the branch is poorer by the whole amount and the day's result
/// has no line that explains it: not profit, not loss, not an expense. Money
/// that vanished in the recording rather than in the counting, and days spent
/// looking for a miscount that never happened.
///
/// So the two sides became one thing with one reference, written in one
/// transaction and reversed as one act. A half transfer is not a state this can
/// be in.
///
/// ## Why the money can stop in the middle
///
/// Because it does. Cash carried to the bank leaves the till today and appears
/// in the account tomorrow, and a system that books both sides at once claims a
/// bank balance the branch cannot yet draw on — which is not a bookkeeping
/// blemish but a cheque that bounces. `PENDING_ARRIVAL` is that gap made
/// visible, and `IN_TRANSIT` is where the money sits while it lasts.
///
/// The manager alone ends it. Whoever can say "it arrived" can say so of money
/// that never did, which closes the second half onto nothing at all.
model Transfer {
  id String @id @default(cuid())

  /// Human reference, on both movements and on the screen.
  reference String @unique

  fromDrawerId String
  fromDrawer   Drawer @relation("TransferFrom", fields: [fromDrawerId], references: [id])
  toDrawerId   String
  toDrawer     Drawer @relation("TransferTo", fields: [toDrawerId], references: [id])

  /// What leaves the source, commission included. Scaled 1e8.
  amount BigInt

  /// What the other side keeps for moving it — nothing, usually.
  ///
  /// Recorded as an expense of its own rather than shaved off the amount,
  /// because it is one: the branch is poorer by it, and a transfer that quietly
  /// arrived smaller than it left would report that loss as nothing at all.
  commission BigInt @default(0)

  /// PENDING_APPROVAL | PENDING_ARRIVAL | COMPLETED | REVERSED | REJECTED
  status String @default("COMPLETED")

  /// Which of the broker's accounts it went through, when one side is his.
  account String?
  note    String?

  /// What the sender came back with — the screenshot's reference, usually.
  /// The office already works this way in its group chat; this is where the
  /// evidence lands so the record carries it rather than the phone.
  proof String?

  businessDayId String
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])

  createdById String
  createdBy   User   @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?     @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  confirmedById String?
  confirmedBy   User?     @relation("TransferConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?

  reversedById String?
  reversedBy   User?     @relation("TransferReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([businessDayId])
  @@index([fromDrawerId])
  @@index([toDrawerId])
  @@map("transfers")
}

/// What one person may do with one drawer.
///
/// Until this existed, the drawers were all-or-nothing: `exchange.drawer.manage`
/// opened every one of them, in every currency, to whoever held it. That is the
/// right shape for the manager and the wrong shape for anyone he wants to
/// delegate to — "move money between these two drawers and nothing else" had no
/// way to be said.
///
/// The row itself is the visibility. Somebody with no grant on a drawer does not
/// see it; the three flags say what he may do with the one he can. This is why
/// there is no `canView` column: a grant that permitted nothing would be a row
/// that means "he can look at it", which is exactly what an empty grant already
/// means.
///
/// Grants only ever ADD. Holding `exchange.drawer.manage` is unrestricted by
/// design — a manager who could be locked out of his own treasury by a row in a
/// table is a support call waiting to happen, and there is nobody above him to
/// undo it.
model DrawerGrant {
  id String @id @default(cuid())

  userId String
  user   User   @relation("DrawerGrantHolder", fields: [userId], references: [id], onDelete: Cascade)

  drawerId String
  drawer   Drawer @relation(fields: [drawerId], references: [id], onDelete: Cascade)

  /// Money in. The half of funding that cannot take anything out — a person who
  /// collects from customers all day has no business withdrawing what he
  /// collected, and this is how that is said.
  canDeposit Boolean @default(false)

  /// Money out.
  canWithdraw Boolean @default(false)

  /// Moving money to another drawer. Separate from the two above because it is
  /// the one that never changes what the branch is worth, and may reasonably be
  /// given to somebody trusted with neither of the others.
  canTransfer Boolean @default(false)

  /// Who granted it. Kept because a permission nobody remembers granting is one
  /// nobody thinks to revoke.
  grantedById String?
  grantedBy   User?   @relation("DrawerGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, drawerId])
  @@index([userId])
  @@index([drawerId])
  @@map("drawer_grants")
}

/// Every change to a drawer, append-only.
///
/// Not a journal: there is no opposite line and nothing has to balance. It
/// exists so a balance can be explained — this drawer holds what it holds
/// because of these movements — which is the part of a ledger still worth
/// having at this size.
model DrawerMovement {
  id       String @id @default(cuid())
  drawerId String
  drawer   Drawer @relation(fields: [drawerId], references: [id])

  /// IN | OUT
  direction    String
  amount       BigInt
  /// The drawer balance immediately after this movement was applied.
  balanceAfter BigInt

  /// TRANSACTION | FUNDING | HANDOVER | TRANSFER | REVERSAL
  ///
  /// `TRANSFER` is its own reason rather than funding with a category, and that
  /// distinction is what keeps the day honest: the result is measured from
  /// funding rows, and money moved between the branch's own balances changes
  /// what it is worth by nothing. Filed as funding it would have to be
  /// explained away; filed as itself it never enters the sum.
  reason String

  /// Why a funding movement happened, which the daily result cannot be measured
  /// without. Money the owner puts in is not profit and money they take out is
  /// not a loss, so the two have to be told apart from everything else before
  /// the change in the branch's worth means anything.
  ///
  /// OWNER_IN | OWNER_OUT | EXPENSE | TRANSFER | CORRECTION. Null on anything
  /// that is not funding — a transaction says why it happened by being one.
  category String?

  /// Which of the broker's accounts this went through.
  ///
  /// The office keeps no books per account — its claim is on the broker, not on
  /// an account — but the instruction that leaves for him has to say which one,
  /// and this is the only place that survives long enough to be checked against
  /// his statement afterwards. Null on anything that did not go through him.
  account String?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  /// The day this movement belongs to.
  ///
  /// Not the calendar date it happened on. A day is opened and closed by hand,
  /// and the result of one is measured by what moved inside it — so a manager
  /// funding the till at half past midnight, or a day opened for a date that is
  /// not today, must land where the close will look for it. Every other way
  /// money moves already belongs to a day; this makes funding belong too.
  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([drawerId, createdAt])
  @@index([transactionId])
  @@index([businessDayId])
  @@index([account])
  @@map("drawer_movements")
}

// ===========================================================================
// CUSTOMERS
// ===========================================================================

model Customer {
  id   String @id @default(cuid())
  code String @unique

  type       String  @default("INDIVIDUAL") // INDIVIDUAL | COMPANY
  fullNameEn String
  fullNameAr String
  phone      String?
  altPhone   String?
  email      String?

  nationalId String?
  passportNo String?
  taxNumber  String?

  address String?
  city    String?
  country String  @default("PS")

  // NONE | PENDING | VERIFIED | REJECTED | EXPIRED
  kycStatus     String    @default("NONE")
  kycVerifiedAt DateTime?
  riskLevel     String    @default("LOW") // LOW | MEDIUM | HIGH
  isBlocked     Boolean   @default(false)
  blockReason   String?


  /// Maximum negative balance allowed, scaled 1e8, in `creditCurrency`.
  creditLimit    BigInt  @default(0)
  creditCurrency String?

  notes String?
  tags  String? // JSON: string[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions    Transaction[]
  documents       CustomerDocument[]
  depositRequests UsdtDepositRequest[]
  wallets         CustomerWallet[]
  payouts         CustomerPayout[]

  @@index([fullNameEn])
  @@index([fullNameAr])
  @@index([phone])
  @@index([kycStatus])
  @@map("customers")
}

/// A wallet address a customer has sent USDT from.
///
/// Learned from the arrivals the counter settles, so the next transfer from the
/// same address arrives already knowing whose it is. Keyed per customer rather
/// than per address on purpose: an exchange's hot wallet sends for thousands of
/// people, and the second customer seen on one is what marks it as shared —
/// the counter then refuses to guess.
model CustomerWallet {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  network String
  address String

  timesSeen   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([network, address, customerId])
  @@index([network, address])
  @@map("customer_wallets")
}

/// A sending address marked as shared — an exchange's hot wallet, typically —
/// so it is never again taken for one customer, whoever was first seen on it.
model SharedAddress {
  id      String @id @default(cuid())
  network String
  address String

  markedById String?
  createdAt  DateTime @default(now())

  @@unique([network, address])
  @@map("shared_addresses")
}

/// Where a customer is paid when it is not in cash: a channel from the list
/// the manager keeps, and the account on it.
///
/// The one marked default is what the counter offers first; it follows the
/// customer's last choice, because the account a person used last time is the
/// best guess at the one they want this time.
model CustomerPayout {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  channel   String
  account   String
  isDefault Boolean @default(false)

  timesUsed  Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([customerId, channel, account])
  @@index([customerId])
  @@map("customer_payouts")
}

model CustomerDocument {
  id         String    @id @default(cuid())
  customerId String
  type       String // ID_CARD | PASSPORT | TRADE_LICENSE | OTHER
  number     String
  issuedAt   DateTime?
  expiresAt  DateTime?
  issuer     String?
  fileRef    String?
  notes      String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

// ===========================================================================
// EXCHANGE — transactions
// ===========================================================================

model Transaction {
  id        String @id @default(cuid())
  reference String @unique // TXN-20260808-00001

  /// EXCHANGE — cash for cash on the machine.
  /// USDT_RECEIVE — USDT taken at the window, cash handed back.
  /// USDT_SEND — cash taken at the window, USDT sent to the customer's wallet.
  /// REMITTANCE_OUT / REMITTANCE_IN — a transfer carried by the correspondent.
  /// All the same shape: the customer gives one thing and takes another.
  type   String
  /// POSTED | PENDING_TRANSFER | REVERSED. Recording is posting; there is no
  /// draft and no approval.
  ///
  /// PENDING_TRANSFER means the money has already left the branch's balances —
  /// the bank leg is reserved the instant it is promised — but nobody has yet
  /// confirmed the transfer actually went out. It is a promise awaiting proof,
  /// not money awaiting a decision.
  status String @default("POSTED")

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // --- Amounts (all scaled 1e8) -------------------------------------------
  fromCurrency String
  fromAmount   BigInt
  toCurrency   String
  toAmount     BigInt
  /// Applied rate, scaled 1e8. 1 unit of fromCurrency = rate units of toCurrency.
  rate         BigInt        @default(100000000)
  rateId       String?
  appliedRate  ExchangeRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)

  /// Spread earned against the mid rate, in toCurrency. Shown to the manager.
  profitAmount BigInt @default(0)

  /// The broken price this deal was struck at, if it was one. Present on the
  /// transaction so the concession is read where the deal is read, not only in
  /// a list of approvals somebody has to think to open.
  priceException PriceException?

  // --- How the customer paid, and how they were paid ----------------------
  //
  // Each pair always sums to exactly its own total — the intake legs to
  // `fromAmount`, the payout legs to `toAmount`. Not approximately: a split
  // that is allowed to disagree with its own total leaks a fraction on every
  // trade, and the server refuses one that does.
  //
  // Both sides can be split because both sides can go through the broker. A
  // customer buying USDT may hand over part in notes and transfer the rest to
  // the broker's account, at a different price for each part — the mirror of
  // the exchange machine, where the branch pays out the same two ways.
  //
  // The ordinary all-cash trade leaves both broker legs at zero, so nothing
  // about its shape changes.
  intakeCashAmount   BigInt @default(0)
  intakeBrokerAmount BigInt @default(0)
  payoutCashAmount   BigInt @default(0)
  payoutBankAmount   BigInt @default(0)

  /// Which of the broker's accounts the customer paid into. Null unless the
  /// intake had a broker leg. Free text for the same reason as the payout
  /// channel below.
  intakeBankChannel String?

  /// Where the transfer was sent — a bank, a wallet service, whatever the
  /// manager has listed. Free text rather than a foreign key on purpose: the
  /// name is a fact about a transfer that already happened, and renaming or
  /// removing a destination later must not rewrite what was recorded at the
  /// time. Null whenever there was no bank leg.
  payoutBankChannel String?

  /// The account on that channel the transfer went to — a wallet number, a
  /// phone number, an IBAN. Recorded as given, for the same reason the channel
  /// is: the instruction that left for the broker has to be checkable later
  /// against what he says he paid. Null when there was no bank leg, and on
  /// transfers recorded before the field existed.
  payoutAccount String?

  /// Where the USDT was sent, for a withdrawal. Recorded as typed: the address
  /// is a fact about a transfer that already happened, and it belongs to the
  /// customer rather than to anything this system owns.
  payoutAddress String?

  /// Which of the branch's wallets the withdrawal was promised from. It fixes
  /// the network the address was checked against, and it is where the outgoing
  /// transfer will be looked for when the promise is reconciled.
  payoutWalletId String?
  payoutWallet   Wallet? @relation("TransactionPayoutWallet", fields: [payoutWalletId], references: [id], onDelete: SetNull)


  /// When someone confirmed the promised transfer actually left. Null while
  /// pending. It covers both promises a branch can make — a bank transfer
  /// through the broker, and USDT sent from the branch's own wallet.
  transferConfirmedAt   DateTime?
  transferConfirmedById String?
  transferConfirmedBy   User?     @relation("TransactionTransferConfirmedBy", fields: [transferConfirmedById], references: [id], onDelete: SetNull)

  /// Whether a manager has released this for sending — and who, and when.
  ///
  /// Only USDT sales ask for it today, and only when the office has the
  /// setting on. `PENDING` means the coins are reserved and the customer has
  /// paid, but nobody may put the transfer on the chain yet: a send is the one
  /// step in this system that no later entry can undo, so it is the one step
  /// worth a second person's signature.
  ///
  /// Null on everything that never needed asking.
  approvalState     String?   /// PENDING | APPROVED | DECLINED
  approvalDecidedAt DateTime?
  approvedById      String?
  approvedBy        User?     @relation("TransactionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalNote      String?

  // --- Who was at the window ----------------------------------------------
  counterpartyName  String?
  counterpartyPhone String?

  notes String?

  createdById String
  createdBy   User   @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  reversalOfId  String?      @unique
  reversalOf    Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    Transaction? @relation("TransactionReversal")
  reverseReason String?

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts         Receipt[]
  movements        DrawerMovement[]
  chainTransaction ChainTransaction?
  depositRequest   UsdtDepositRequest?

  @@index([status, createdAt])
  @@index([approvalState, createdAt])
  @@index([type, createdAt])
  @@index([createdById, createdAt])
  @@index([customerId])
  @@map("transactions")
}

/// A price the manager broke, for one deal, before it was struck.
///
/// The teller meets a customer who will walk over an agura, and the office
/// would rather take the trade than the principle. What makes that safe is not
/// the approval — it is that the approval cannot outlive the moment it was
/// given. An approved price with no leash becomes a standing discount: used
/// tomorrow, for a different customer, at a different amount, by a different
/// teller, and nobody would ever see it happen.
///
/// So it carries four leashes, and every one of them is checked again at the
/// instant the money moves rather than at the moment the button was pressed:
///
///   1. it expires in minutes
///   2. it names the pair, the direction and the channel, and caps the amount
///   3. it can be spent once
///   4. it is stamped on the transaction it was spent on
///
/// This does not reintroduce approvals of *transactions*. What is approved is a
/// **price**, before the deal; the deal itself still posts the moment it is
/// recorded. And the browser is still not trusted: the teller sends this row's
/// id, never a rate, and the server reads the rate from here.
model PriceException {
  id        String @id @default(cuid())
  reference String @unique // PEX-20260811-00001

  /// PENDING | APPROVED | REJECTED | USED | EXPIRED | CANCELLED
  status String @default("PENDING")

  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  /// Who asked. Only they may spend it — an approval is given to a person
  /// standing in front of a customer, not to the branch.
  requestedById String
  requestedBy   User   @relation("PriceExceptionRequester", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("PriceExceptionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  // --- What it is bound to -------------------------------------------------
  fromCurrency String
  toCurrency   String
  /// CASH | BROKER — the leg it prices. A deal settled the other way is a
  /// different price and needs its own approval.
  channel      String @default("CASH")
  /// The most the customer may hand over on that leg, scaled 1e8. Asked for a
  /// figure, granted for at most that figure.
  maxFromAmount BigInt

  // --- The three rates, all scaled 1e8, all frozen here --------------------
  /// What the board said when the teller asked.
  boardRate BigInt
  /// What the teller asked for. Always worse for the office than the board —
  /// a better price needs no permission.
  requestedRate BigInt
  /// What the manager actually granted. May be short of what was asked.
  approvedRate BigInt?
  /// Wholesale cost at the moment of the decision, derived from the cut-off
  /// rates the manager himself approves. This is the number that turns "does
  /// that seem reasonable?" into "are we still above cost?", and it is copied
  /// here rather than looked up later for the same reason every historical
  /// figure in this system is frozen.
  costRate BigInt?

  reason       String?
  decisionNote String?

  /// What the concession cost, in the currency the office handed out, worked
  /// out at the moment the deal was struck and frozen here.
  ///
  /// Computed then rather than derived later because later is too late: it
  /// depends on the amount of the leg the approval actually priced, which a
  /// split does not put on the transaction, and on the board as it stood — and
  /// the board moves. A teller's evaluation cannot rest on a figure that
  /// quietly changes when the manager republishes a rate.
  concededAmount   BigInt?
  concededCurrency String?

  /// After this instant it is refused, whatever its status says.
  expiresAt DateTime?

  /// The deal it was spent on. Unique, which is what makes "once" true even if
  /// two requests arrive in the same millisecond.
  usedByTransactionId String?      @unique
  usedByTransaction   Transaction? @relation(fields: [usedByTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  decidedAt DateTime?
  usedAt    DateTime?

  @@index([status, createdAt])
  @@index([requestedById, status])
  @@map("price_exceptions")
}

model Receipt {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  number          String    @unique
  locale          String    @default("ar")
  printedCount    Int       @default(0)
  lastPrintedAt   DateTime?
  lastPrintedById String?
  createdAt       DateTime  @default(now())

  @@index([transactionId])
  @@map("receipts")
}

// ===========================================================================
// DAILY CLOSING
// ===========================================================================

/// The rate the manager approves for valuing a currency at the close.
///
/// Not a trading rate. The board says what the counter charges; this says what
/// the branch's holdings are worth, and the two are different judgements — the
/// second is the one the owner's profit is measured against.
///
/// One row per currency per day, written only when the manager sets one. A day
/// with no row for a currency uses the most recent earlier row, which is what
/// "the rates roll forward" means: silence is agreement with yesterday, not an
/// absence, and a day whose rates were never touched still values correctly.
model CutoffRate {
  id           String   @id @default(cuid())
  /// Calendar date at 00:00 local time, the same key a business day uses.
  date         DateTime
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// Units of the base currency for one unit of this one, scaled 1e8.
  rate BigInt

  note      String?
  setById   String
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, currencyCode])
  @@index([currencyCode, date])
  @@map("cutoff_rates")
}

/// What a drawer held when a day was closed, and what it was worth.
///
/// Written once, at the close, and never recomputed. The rate is copied onto
/// the row rather than looked up later for the reason every historical figure
/// in this system is frozen: a result that quietly changes when the manager
/// approves tomorrow's rate is not a result, it is a moving opinion about one.
model DayPosition {
  id            String      @id @default(cuid())
  businessDayId String
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id], onDelete: Cascade)

  drawerId String
  drawer   Drawer @relation(fields: [drawerId], references: [id])

  currencyCode String
  /// CASH | BROKER | CORRESPONDENT, copied so a closed day reads on its own.
  kind         String
  balance      BigInt
  /// The cut-off rate applied, scaled 1e8. The base currency's is exactly 1.
  cutoffRate   BigInt

  createdAt DateTime @default(now())

  @@unique([businessDayId, drawerId])
  @@index([businessDayId])
  @@map("day_positions")
}

model BusinessDay {
  id       String   @id @default(cuid())
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
  /// Calendar date at 00:00 local time.
  date     DateTime

  /// OPEN | CLOSING | CLOSED | REOPENED
  status String @default("OPEN")

  openedById String
  openedBy   User     @relation("DayOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime @default(now())

  closedById String?
  closedBy   User?     @relation("DayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime?

  notes String?

  transactions  Transaction[]
  positions     DayPosition[]
  movements     DrawerMovement[]
  handovers     Handover[]
  transfers     Transfer[]
  shifts        Shift[]
  discrepancies Discrepancy[]

  @@unique([branchId, date])
  @@index([status])
  @@map("business_days")
  priceExceptions PriceException[]
  shiftReports ShiftReport[]
  tillCounts   TillCount[]
}

// ===========================================================================
// USDT / BLOCKCHAIN MONITORING
// ===========================================================================

model Wallet {
  id      String @id @default(cuid())
  label   String
  labelAr String

  /// TRON | ETHEREUM | BSC
  network         String
  address         String
  contractAddress String?
  tokenSymbol     String  @default("USDT")

  /// Watch-only wallets are monitored but never debited by the system.
  isWatchOnly Boolean @default(true)
  isActive    Boolean @default(true)

  /// Shown to customers at the counter. A monitored wallet is not automatically
  /// an address we hand out — the manager decides which ones the teller may
  /// display, and the counter screen offers nothing else.
  isCounterAddress Boolean @default(false)
  counterSortOrder Int     @default(0)

  /// The drawer this wallet's holdings count towards.
  drawerId String?
  drawer   Drawer? @relation(fields: [drawerId], references: [id], onDelete: SetNull)

  balance          BigInt    @default(0)
  balanceUpdatedAt DateTime?

  minConfirmations      Int     @default(19)
  notifyOnIncoming      Boolean @default(true)
  notifyOnOutgoing      Boolean @default(true)
  autoCreateTransaction Boolean @default(true)

  syncCursor     String?
  lastSyncedAt   DateTime?
  lastSyncStatus String? // OK | ERROR | NEVER
  lastSyncError  String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions    ChainTransaction[]
  snapshots       WalletSnapshot[]
  /// A Binance account's read-only key. Its own table so loading a wallet never loads it.
  credential      WalletCredential?
  syncRuns        WalletSyncRun[]
  depositRequests UsdtDepositRequest[]
  /// Withdrawals the branch promised to send from this wallet.
  payouts         Transaction[]        @relation("TransactionPayoutWallet")

  @@unique([network, address, tokenSymbol])
  @@index([isActive])
  @@index([isCounterAddress, counterSortOrder])
  @@map("wallets")
}

/// A customer standing at the counter, about to send USDT to one of our
/// addresses.
///
/// The record exists before the money does, which is the point: it fixes the
/// exact amount expected and the window it is expected in, so an arriving
/// transfer can be matched to a person rather than guessed at. Without it the
/// only evidence is a chain entry proving that *someone* sent USDT, and paying
/// cash against that is paying against a guess.
model UsdtDepositRequest {
  id        String @id @default(cuid())
  reference String @unique

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
  network  String
  address  String

  /// What the customer said they would send.
  requestedAmount BigInt
  /// What they are asked to send — the requested amount nudged to a value no
  /// other open request shares, so two customers sending "500" are never
  /// confused for one another.
  expectedAmount  BigInt

  /// The currency and rate agreed at the counter, so the payout is the figure
  /// the customer was quoted rather than whatever the rate has moved to by the
  /// time the chain confirms.
  payoutCurrency String
  quotedRate     BigInt
  quotedAmount   BigInt

  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  counterpartyName  String?
  counterpartyPhone String?

  /// OPEN | MATCHED | COMPLETED | EXPIRED | CANCELLED
  status String @default("OPEN")

  matchedChainTransactionId String?           @unique
  matchedChainTransaction   ChainTransaction? @relation(fields: [matchedChainTransactionId], references: [id], onDelete: SetNull)
  matchedAt                 DateTime?

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  cancelReason String?
  notes        String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  expiresAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([walletId, status])
  @@index([expectedAmount, status])
  @@map("usdt_deposit_requests")
}

model WalletSnapshot {
  id       String   @id @default(cuid())
  walletId String
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  balance  BigInt
  at       DateTime @default(now())

  @@index([walletId, at])
  @@map("wallet_snapshots")
}

model WalletSyncRun {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  provider   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | ERROR
  status     String    @default("RUNNING")
  fetched    Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  error      String?

  @@index([walletId, startedAt])
  @@map("wallet_sync_runs")
}

model ChainTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  txHash    String
  network   String
  direction String // IN | OUT

  fromAddress     String
  toAddress       String
  amount          BigInt // scaled 1e8
  tokenSymbol     String  @default("USDT")
  contractAddress String?

  blockNumber    BigInt?
  blockTimestamp DateTime?
  confirmations  Int       @default(0)
  networkFee     BigInt    @default(0)

  /// PENDING | CONFIRMED | FAILED | ORPHANED
  status String @default("PENDING")

  /// Internal transaction created from this on-chain movement.
  linkedTransactionId String?      @unique
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  depositRequest UsdtDepositRequest?

  isReconciled Boolean   @default(false)
  processedAt  DateTime?
  notes        String?

  firstSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([walletId, txHash, direction])
  @@index([status, blockTimestamp])
  @@index([walletId, blockTimestamp])
  @@index([txHash])
  @@map("chain_transactions")
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id String @id @default(cuid())

  /// CRITICAL | WARNING | INFO | SUCCESS
  severity String @default("INFO")
  /// Machine key used for i18n, e.g. "usdt.incoming".
  eventKey String
  module   String

  titleEn String
  titleAr String
  bodyEn  String
  bodyAr  String

  entityType String?
  entityId   String?
  link       String?
  payload    String? // JSON

  isBroadcast Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([severity])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

// ===========================================================================
// AUDIT — append only, hash chained
// ===========================================================================

/// Immutable audit trail. Each row carries the hash of the previous row, so any
/// mutation or deletion breaks the chain and is detected by the verifier
/// (src/modules/audit/verify). The application never updates or deletes rows.
model AuditLog {
  /// Monotonic sequence AND primary key — the chain is ordered by this value.
  id Int @id @default(autoincrement())

  at DateTime @default(now())

  actorId   String?
  actorName String?
  actorIp   String?
  userAgent String?
  sessionId String?

  /// CREATE | UPDATE | DELETE | LOGIN | LOGOUT | POST | REVERSE | CANCEL
  /// | REVERSE | PERMISSION_CHANGE | RATE_CHANGE | WALLET_CHANGE | BACKUP
  /// | RESTORE | SETTING_CHANGE | EXPORT | PRINT | SYNC | SECURITY
  action     String
  module     String
  entityType String?
  entityId   String?

  summaryEn String
  summaryAr String

  beforeData String? // JSON snapshot
  afterData  String? // JSON snapshot
  metadata   String? // JSON

  /// SHA-256 chain: hash = H(prevHash || canonical(record))
  prevHash String
  hash     String @unique

  @@index([at])
  @@index([actorId, at])
  @@index([module, at])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================================================
// SETTINGS
// ===========================================================================

model SystemSetting {
  key         String  @id
  value       String // JSON encoded
  valueType   String  @default("string") // string | number | boolean | json
  category    String  @default("general")
  isSecret    Boolean @default(false)
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

model ApiCredential {
  id               String  @id @default(cuid())
  name             String
  provider         String // TRON | ETHERSCAN | SMTP | WEBHOOK
  /// AES-256-GCM ciphertext, keyed from AUTH_SECRET.
  secretCiphertext String?
  baseUrl          String?
  config           String? // JSON, non-secret
  isActive         Boolean @default(true)

  lastUsedAt  DateTime?
  lastStatus  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, name])
  @@map("api_credentials")
}

// ===========================================================================
// BACKUP
// ===========================================================================

model Backup {
  id        String  @id @default(cuid())
  filename  String
  path      String
  sizeBytes BigInt  @default(0)
  checksum  String? // SHA-256 of the archive

  /// AUTOMATIC | MANUAL
  type   String @default("MANUAL")
  /// PENDING | RUNNING | COMPLETED | FAILED | VERIFIED | CORRUPT
  status String @default("PENDING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  verifiedAt DateTime?
  error      String?
  notes      String?

  appVersion String?
  tableCount Int     @default(0)
  rowCount   Int     @default(0)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  restores RestoreRun[]

  @@index([status, startedAt])
  @@map("backups")
}

model RestoreRun {
  id       String @id @default(cuid())
  backupId String
  backup   Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  /// RUNNING | COMPLETED | FAILED
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  error         String?
  rowsRestored  Int       @default(0)
  requestedById String?

  @@index([backupId])
  @@map("restore_runs")
}

// ===========================================================================
// BACKGROUND WORK
// ===========================================================================

model Job {
  id      String  @id @default(cuid())
  name    String
  queue   String  @default("default")
  payload String? // JSON

  /// PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  status   String @default("PENDING")
  priority Int    @default(100)

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?
  result     String?

  /// Prevents duplicate enqueues of the same logical work.
  uniqueKey String?

  createdAt DateTime @default(now())

  @@index([status, runAt])
  @@index([queue, status])
  @@index([uniqueKey])
  @@map("jobs")
}

model ScheduledTask {
  id              String  @id @default(cuid())
  key             String  @unique
  nameEn          String
  nameAr          String
  jobName         String
  payload         String?
  intervalSeconds Int
  isEnabled       Boolean @default(true)

  lastRunAt  DateTime?
  nextRunAt  DateTime  @default(now())
  lastStatus String? // OK | ERROR
  lastError  String?
  runCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled, nextRunAt])
  @@map("scheduled_tasks")
}

/// Monotonic counters for human-readable document references.
model Sequence {
  key       String   @id // "TXN:20260806"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("sequences")
}

/// Autosaved form state so a teller never loses work in progress.
model Draft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  formKey  String
  entityId String @default("new")
  payload  String // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, formKey, entityId])
  @@index([userId, updatedAt])
  @@map("drafts")
}

// ===========================================================================
// TILL COUNT — جرد الصندوق
// ===========================================================================

/// A count of what a teller holds, measured against what they traded.
///
/// The alternative to the handover: no float is declared and nothing changes
/// hands during the day. At the end of it the books work out what the teller
/// should hold from their own deals — what they started with, plus the cash
/// they took in, less the cash they paid out, plus anything the safe gave them,
/// less anything it took — and somebody counts the drawer against that.
///
/// Each count closes a period: the next one starts where this one ended, and
/// opens with what was left with the teller here (`kept`). So no deal is ever
/// counted twice, and none falls between two counts.
model TillCount {
  id        String @id @default(cuid())
  reference String @unique // CNT-20261025-00001

  tellerId String
  teller   User   @relation("TillCountTeller", fields: [tellerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: SetNull)

  /// The deals counted are the teller's own between these two moments.
  periodStart DateTime
  periodEnd   DateTime

  /// Whoever counted. Never the teller; the service refuses that.
  countedById String
  countedBy   User   @relation("TillCountCountedBy", fields: [countedById], references: [id])

  note      String?
  createdAt DateTime @default(now())

  lines         TillCountLine[]
  discrepancies Discrepancy[]

  @@index([tellerId, createdAt])
  @@map("till_counts")
}

/// One currency of a till count. Every figure is scaled 1e8, and
/// expected = opening + received - paid + toppedUp - drawn.
model TillCountLine {
  id      String    @id @default(cuid())
  countId String
  count   TillCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  opening    BigInt
  received   BigInt
  paid       BigInt
  toppedUp   BigInt
  drawn      BigInt
  expected   BigInt
  counted    BigInt
  /// Expected minus counted: positive is a shortage, negative a surplus.
  difference BigInt
  /// Left with the teller as the next period's opening.
  kept       BigInt

  /// The notes counted, as JSON {"200": 3, "coins": "12.5"}, when the counter
  /// used them. Kept for the record; nothing reads it back into the sums.
  denominations String?

  @@index([countId])
  @@map("till_count_lines")
}

/// Cash the safe gave a teller (IN) or took from them (OUT) between counts.
///
/// Nothing moves in the drawers — without a shift the teller trades out of the
/// treasury's cash already — so this only tells the next count about it.
/// Without it, change handed over at noon would read as a surplus tonight.
model TillAdjustment {
  id String @id @default(cuid())

  tellerId String
  teller   User   @relation("TillAdjustmentTeller", fields: [tellerId], references: [id])

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// IN — given to the teller. OUT — taken from them.
  direction String
  amount    BigInt
  note      String?

  createdById String
  createdBy   User     @relation("TillAdjustmentBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tellerId, createdAt])
  @@map("till_adjustments")
}

/// The box a teller says he opened a day with, per currency.
///
/// His own figure, entered by him at the start of the day: the closing box on
/// his day's account is this plus what his deals put in the drawer, less what
/// they took out. Kept per local day as the counter calls it ("2026-10-28"),
/// because that is the day he counts — not a business day the office may
/// reopen, and not a UTC date that changes at two in the morning.
model TellerOpening {
  id String @id @default(cuid())

  tellerId String
  teller   User   @relation(fields: [tellerId], references: [id])

  /// The counter's local day, YYYY-MM-DD.
  day String

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// Scaled 1e8.
  amount BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tellerId, day, currencyCode])
  @@map("teller_openings")
}

/// The linked WhatsApp number's session — what WhatsApp Web would keep in the
/// browser, kept here so it survives a deploy. One row per key the library
/// asks for: the credentials under "creds", and its signal keys beside them.
/// Values are JSON as the library writes it (buffers encoded). Emptied when
/// the number is unlinked.
model WhatsappAuth {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("whatsapp_auth")
}

/// The API key a Binance wallet is read with — read-only at Binance, and
/// encrypted here (AES-256-GCM under AUTH_SECRET), the key as well as the
/// secret. Kept apart from `Wallet` because a wallet row travels to screens,
/// and a relation is only ever loaded by asking for it by name.
model WalletCredential {
  walletId  String   @id
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  apiKey    String
  apiSecret String
  updatedAt DateTime @updatedAt

  @@map("wallet_credentials")
}
