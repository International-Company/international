{
  "name": "ifms",
  "version": "1.0.0",
  "private": true,
  "description": "IFMS — International Financial Management System",
  "scripts": {
    "dev": "npm run db:prepare && next dev",
    "build": "npm run db:prepare && prisma generate && next build",
    "start": "next start",
    "deploy:start": "node scripts/pre-deploy-schema.mjs && prisma db push --skip-generate && node scripts/post-deploy-data.mjs && (npm run db:seed || echo '[deploy] seed skipped — see logs above') && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:prepare": "node scripts/prepare-db.mjs",
    "db:generate": "npm run db:prepare && prisma generate",
    "db:push": "npm run db:prepare && prisma db push",
    "db:migrate": "npm run db:prepare && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:prepare && prisma db push --force-reset && npm run db:seed",
    "db:clear-operational": "node scripts/clear-operational-data.mjs",
    "reset-password": "tsx --conditions=react-server scripts/reset-password.mts",
    "setup": "npm run db:prepare && prisma generate && prisma db push && npm run db:seed",
    "test": "tsx --conditions=react-server --test \"tests/*.test.ts\"",
    "verify:shift": "tsx --conditions=react-server scripts/verify-shift.mts",
    "verify:price-exception": "tsx --conditions=react-server scripts/verify-price-exception.mts",
    "verify:permissions": "tsx --conditions=react-server scripts/verify-permissions.mts",
    "verify:teller-result": "tsx --conditions=react-server scripts/verify-teller-result.mts",
    "verify:shift-report": "tsx --conditions=react-server scripts/verify-shift-report.mts",
    "verify:reports": "tsx --conditions=react-server scripts/verify-reports.mts",
    "verify:withdrawal-approval": "tsx --conditions=react-server scripts/verify-withdrawal-approval.mts",
    "verify:usdt-counter": "tsx --conditions=react-server scripts/verify-usdt-counter.mts",
    "verify:auto-send": "tsx --conditions=react-server scripts/verify-auto-send.mts",
    "wallet:new": "tsx --conditions=react-server scripts/new-hot-wallet.mts",
    "verify:wallet-removal": "tsx --conditions=react-server scripts/verify-wallet-removal.mts"
  },
  "//dependencies": "Anything `next build`, `prisma generate` or the deploy start command needs at build time lives here, NOT in devDependencies. Platforms that set NODE_ENV=production during the build (Railway, Heroku, Nixpacks) make npm skip devDependencies entirely, so a build-time package placed there is simply absent when the build runs.",
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^3.1.0",
    "@prisma/client": "^6.2.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "prisma": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  }
}
